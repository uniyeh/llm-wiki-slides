<mxfile host="app.diagrams.net"><diagram id="graph" name="LLM Wiki Graph"><mxGraphModel dx="1400" dy="650" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="650" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b style=&#x27;font-size:22px&#x27;&gt;LLM Wiki × 教學簡報：Graph 流程（依 AGENTS.md）&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:13px;color:#666&#x27;&gt;每個節點都寫清楚：目標／限制／完成標準／停止條件／觸發條件　｜　工具：tools/lint.py、tools/build_index.py&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell><mxCell id="lane" value="&lt;b&gt;使用者回饋 → 規則（非阻塞）&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="900" height="168" as="geometry"/></mxCell><mxCell id="ingest" value="&lt;b&gt;① INGEST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;讀論文 → wiki 頁&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="lint" value="&lt;b&gt;② LINT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;檢查一致性&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="240" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="synth" value="&lt;b&gt;③ SYNTHESIZE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;整合延伸發想&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="440" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="outline" value="&lt;b&gt;④ OUTLINE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;寫教學劇本&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="640" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="build" value="&lt;b&gt;⑤ BUILD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;做 HTML 簡報&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="840" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="review" value="&lt;b&gt;⑥ REVIEW&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;檢查表＋模擬讀者&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1040" y="200" width="150" height="74" as="geometry"/></mxCell><mxCell id="done" value="&lt;b&gt;完成&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1250" y="207" width="110" height="60" as="geometry"/></mxCell><mxCell id="fb" value="&lt;b&gt;使用者回饋&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;隨時可進入，不擋流程&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="250" height="64" as="geometry"/></mxCell><mxCell id="cls" value="&lt;b&gt;分類&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;找問題源頭&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="360" y="512" width="120" height="80" as="geometry"/></mxCell><mxCell id="rerun" value="&lt;b&gt;退回負責的節點重跑&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="490" width="300" height="56" as="geometry"/></mxCell><mxCell id="rule" value="&lt;b&gt;寫成該節點的規則&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AGENTS.md 完成標準／檢查表&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="566" width="300" height="56" as="geometry"/></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontStyle=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="ingest" target="lint"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontStyle=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="lint" target="synth"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontStyle=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="synth" target="outline"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeWidth=2;strokeColor=#333333;fontColor=#333333;fontStyle=1;exitX=1.000;exitY=0.500;exitDx=0;exitDy=0;entryX=0.000;entryY=0.500;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="outline" target="build"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;stro